NODE_ENV=development
PORT=3001
# Use a random secret of at least 32 characters and keep it stable.
SESSION_SECRET=replace-this-with-a-long-random-secret
# Vercel deployments require MongoDB and a strong SESSION_SECRET; local dev uses SQLite.
# Required only when NODE_ENV is not development.
MONGODB_URI=mongodb+srv://username:password@cluster.example/cabconnect
# Optional restricted browser key for Google Places suggestions.
GOOGLE_MAPS_API_KEY=
# Set this to the deployed public URL outside local development.
PUBLIC_APP_URL=http://localhost:3000
